<div class="flex h-screen bg-gray-50">
  <!-- Sidebar -->
  <aside class="w-64 bg-white border-r border-gray-200 flex flex-col">
    <!-- Logo -->
    <div class="h-16 flex items-center px-6 border-b border-gray-200">
      <a href="/" class="text-xl font-semibold text-gray-900">EstiMate</a>
    </div>
    
<!-- Org selector -->
    <div :if={assigns[:current_organization]} class="px-4 py-3 border-b border-gray-100">
      <a
        href="/organizations"
        class="flex items-center gap-3 px-2 py-2 rounded-lg bg-gray-50 hover:bg-gray-100 transition-colors cursor-pointer"
      >
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-semibold text-sm">
          {String.first(@current_organization.name)}
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-medium text-gray-900 truncate">{@current_organization.name}</p>
        </div>
        <span class="text-gray-400">
          <.icon name="hero-chevron-up-down" class="w-4 h-4" />
        </span>
      </a>
    </div>
    
<!-- Navigation -->
    <nav
      :if={assigns[:active_tab] != :settings}
      class="flex-1 px-4 py-4 space-y-1 overflow-y-auto"
    >
      <.sidebar_link
        :if={assigns[:org_id]}
        href={~p"/org/#{@org_id}"}
        icon="hero-home"
        label="Dashboard"
        active={assigns[:active_tab] == :dashboard}
      />
      <.sidebar_link
        :if={assigns[:org_id]}
        href={~p"/org/#{@org_id}/customers"}
        icon="hero-building-office"
        label="Customers"
        active={assigns[:active_tab] == :customers}
      />
      <div :if={assigns[:org_id]} class="pt-1">
        <div class={[
          "flex items-center gap-3 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider",
          assigns[:active_tab] in [:roles, :templates] && "text-gray-700",
          assigns[:active_tab] not in [:roles, :templates] && "text-gray-400"
        ]}>
          <.icon name="hero-book-open" class="w-5 h-5" />
          <span>Library</span>
        </div>
        <div class="ml-8 space-y-0.5">
          <.sidebar_child_link
            href={~p"/org/#{@org_id}/roles"}
            label="Roles"
            active={assigns[:active_tab] == :roles}
          />
          <.sidebar_child_link
            href={~p"/org/#{@org_id}/templates"}
            label="Templates"
            active={assigns[:active_tab] == :templates}
          />
        </div>
      </div>
      <.sidebar_link
        :if={assigns[:org_id]}
        href={~p"/org/#{@org_id}/projects"}
        icon="hero-folder"
        label="Projects"
        active={assigns[:active_tab] == :projects}
      />

      <div class="pt-4 mt-4 border-t border-gray-100">
        <.sidebar_link
          :if={assigns[:org_id]}
          href={~p"/org/#{@org_id}/settings"}
          icon="hero-cog-6-tooth"
          label="Settings"
          active={assigns[:active_tab] == :settings}
        />
      </div>
    </nav>
    
<!-- Settings sub-navigation -->
    <nav
      :if={assigns[:active_tab] == :settings && assigns[:org_id]}
      class="flex-1 flex flex-col overflow-y-auto"
    >
      <div class="px-4 py-3 border-b border-gray-100">
        <a
          href={~p"/org/#{@org_id}"}
          class="flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors"
        >
          <.icon name="hero-arrow-left" class="w-4 h-4" />
          <span class="text-sm font-medium">Settings</span>
        </a>
      </div>
      <div class="flex-1 px-3 py-3 space-y-0.5">
        <.settings_nav_link
          href={~p"/org/#{@org_id}/settings"}
          label="General"
          active={assigns[:settings_page] == :general}
        />
        <.settings_nav_link
          href={~p"/org/#{@org_id}/settings/members"}
          label="Members"
          active={assigns[:settings_page] == :members}
        />
        <.settings_nav_link
          href={~p"/org/#{@org_id}/settings/currencies"}
          label="Currencies"
          active={assigns[:settings_page] == :currencies}
        />
        <.settings_nav_link
          :if={assigns[:current_membership] && assigns[:current_membership].role in ["owner", "admin"]}
          href={~p"/org/#{@org_id}/settings/ai"}
          label="AI Integration"
          active={assigns[:settings_page] == :ai}
        />
        <.settings_nav_link
          :if={assigns[:current_membership] && assigns[:current_membership].role in ["owner", "admin"]}
          href={~p"/org/#{@org_id}/settings/email"}
          label="Email"
          active={assigns[:settings_page] == :email}
        />
      </div>
    </nav>
    
<!-- User section -->
    <div :if={assigns[:current_user]} class="border-t border-gray-200 p-4">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-gray-200 flex items-center justify-center text-gray-600 font-medium text-sm">
          {String.first(@current_user.name || @current_user.email)}
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-medium text-gray-900 truncate">
            {@current_user.name || @current_user.email}
          </p>
          <p class="text-xs text-gray-500 truncate">{@current_user.email}</p>
        </div>
        <.link href={~p"/users/log_out"} method="delete" class="text-gray-400 hover:text-gray-600">
          <.icon name="hero-arrow-right-on-rectangle" class="w-5 h-5" />
        </.link>
      </div>
    </div>
  </aside>
  
<!-- Main content -->
  <div class="flex-1 flex flex-col overflow-hidden">
    <!-- Top bar -->
    <header class="h-16 bg-white border-b border-gray-200 flex items-center justify-between px-8">
      <div class="w-80">
        <%= if assigns[:org_id] do %>
          <.live_component
            module={EstimateWeb.Components.SearchComponent}
            id="global-search"
            org_id={@org_id}
          />
        <% else %>
          <div class="relative">
            <.icon
              name="hero-magnifying-glass"
              class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400"
            />
            <input
              type="text"
              placeholder="Search..."
              disabled
              class="w-full pl-9 pr-3 py-1.5 text-sm bg-gray-50 border border-gray-200 rounded-lg text-gray-400 cursor-not-allowed placeholder:text-gray-400"
            />
          </div>
        <% end %>
      </div>
      <div class="flex items-center gap-3">
        <.theme_toggle />
      </div>
    </header>
    
<!-- Page content -->
    <main class="flex-1 overflow-y-auto p-8">
      <.flash_group flash={@flash} />
      {@inner_content}
    </main>
  </div>
</div>
