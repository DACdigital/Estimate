<div class="flex h-screen bg-base-200">
  <!-- Sidebar -->
  <aside class="w-64 bg-base-100 border-r border-base-300 flex flex-col">
    <!-- Logo -->
    <div class="h-16 flex items-center px-6 border-b border-base-300">
      <a href="/" class="text-xl font-semibold text-base-content">EstiMate</a>
    </div>
    
<!-- Org selector -->
    <div :if={assigns[:current_organization]} class="px-4 py-3 border-b border-base-content/10">
      <a
        href="/organizations"
        class="flex items-center gap-3 px-2 py-2 rounded-lg bg-base-200 hover:bg-base-300 transition-colors cursor-pointer"
      >
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-semibold text-sm">
          {String.first(@current_organization.name)}
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-medium text-base-content truncate">
            {@current_organization.name}
          </p>
        </div>
        <span class="text-base-content/40">
          <.icon name="hero-chevron-up-down" class="w-4 h-4" />
        </span>
      </a>
    </div>
    
<!-- Navigation -->
    <nav class="flex-1 px-4 py-4 space-y-1 overflow-y-auto">
      <.sidebar_link
        :if={assigns[:org_id]}
        href={~p"/org/#{@org_id}"}
        icon="hero-home"
        label="Dashboard"
        active={assigns[:active_tab] == :dashboard}
      />
      <.sidebar_link
        :if={assigns[:org_id]}
        href={~p"/org/#{@org_id}/customers"}
        icon="hero-building-office"
        label="Customers"
        active={assigns[:active_tab] == :customers}
      />
      <.sidebar_link
        :if={assigns[:org_id]}
        href={~p"/org/#{@org_id}/projects"}
        icon="hero-folder"
        label="Projects"
        active={assigns[:active_tab] == :projects}
      />
      <div :if={assigns[:org_id]} class="pt-4 mt-4 border-t border-base-content/10">
        <div class="flex items-center gap-3 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-base-content/40">
          <.icon name="hero-book-open" class="w-5 h-5" />
          <span>Library</span>
        </div>
        <div class="ml-8 space-y-0.5">
          <.sidebar_child_link
            href={~p"/org/#{@org_id}/roles"}
            label="Roles"
            active={assigns[:active_tab] == :roles}
          />
          <.sidebar_child_link
            href={~p"/org/#{@org_id}/templates"}
            label="Templates"
            active={assigns[:active_tab] == :templates}
          />
        </div>
      </div>

      <div class="pt-4 mt-4 border-t border-base-content/10">
        <.sidebar_link
          :if={assigns[:org_id]}
          href={~p"/org/#{@org_id}/settings"}
          icon="hero-cog-6-tooth"
          label="Settings"
          active={assigns[:active_tab] == :settings}
        />
      </div>
    </nav>
    
<!-- User section -->
    <div :if={assigns[:current_scope]} class="border-t border-base-300 p-4">
      <div class="flex items-center gap-3">
        <.link
          navigate={~p"/account"}
          class="flex items-center gap-3 flex-1 min-w-0 hover:opacity-80 transition-opacity"
        >
          <.avatar
            name={@current_scope.user.name || @current_scope.user.email}
            seed={@current_scope.user.id}
            size={:sm}
          />
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-base-content truncate">
              {@current_scope.user.name || @current_scope.user.email}
            </p>
            <p class="text-xs text-base-content/60 truncate">{@current_scope.user.email}</p>
          </div>
        </.link>
        <.link
          href={~p"/users/log_out"}
          method="delete"
          class="text-base-content/40 hover:text-base-content/70"
        >
          <.icon name="hero-arrow-right-on-rectangle" class="w-5 h-5" />
        </.link>
      </div>
    </div>

    <%!-- Deployed revision --%>
    <div :if={Estimate.BuildInfo.git_sha()} class="px-4 pb-2 -mt-1">
      <p
        class="text-[10px] font-mono text-base-content/25 hover:text-base-content/50 transition-colors text-center truncate"
        title="Deployed revision"
      >
        {Estimate.BuildInfo.git_sha()}
      </p>
    </div>
  </aside>
  
<!-- Main content -->
  <div class="flex-1 flex flex-col overflow-hidden">
    <!-- Top bar -->
    <header class="h-16 bg-base-100 border-b border-base-300 flex items-center justify-between px-8">
      <div class="w-80">
        <%= if assigns[:org_id] do %>
          <.live_component
            module={EstimateWeb.Components.SearchComponent}
            id="global-search"
            org_id={@org_id}
          />
        <% else %>
          <div class="relative">
            <.icon
              name="hero-magnifying-glass"
              class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-base-content/40"
            />
            <input
              type="text"
              placeholder="Search..."
              disabled
              class="w-full pl-9 pr-3 py-1.5 text-sm bg-base-200 border border-base-300 rounded-lg text-base-content/40 cursor-not-allowed placeholder:text-base-content/40"
            />
          </div>
        <% end %>
      </div>
      <div class="flex items-center gap-3">
        <.theme_toggle />
      </div>
    </header>
    
<!-- 2FA enforcement banner -->
    <div
      :if={assigns[:totp_enforcement_deadline]}
      class="bg-warning/10 border-b border-warning/20 px-8 py-2 flex items-center justify-between text-sm"
    >
      <p class="text-warning">
        Your organization requires two-factor authentication.
        You have
        <span class="font-semibold">{days_remaining(assigns[:totp_enforcement_deadline])}</span>
        to set it up.
      </p>
      <.link
        navigate={~p"/account/two-factor/setup"}
        class="text-warning font-medium hover:underline"
      >
        Set up now
      </.link>
    </div>
    <!-- Page content (settings pages get the secondary rail) -->
    <div class="flex-1 flex overflow-hidden">
      <.settings_rail
        :if={assigns[:settings_page]}
        org_id={@org_id}
        settings_page={@settings_page}
        current_membership={@current_membership}
      />
      <main class="flex-1 overflow-y-auto p-8">
        <.flash_group flash={@flash} />
        {@inner_content}
      </main>
    </div>
  </div>
</div>
