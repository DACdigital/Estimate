<div class="flex h-screen bg-base-200">
  <!-- Sidebar -->
  <aside class="w-64 bg-base-100 border-r border-base-300 flex flex-col">
    <!-- Logo -->
    <div class="h-16 flex items-center px-6 border-b border-base-300">
      <a href="/" class="text-xl font-semibold text-base-content">EstiMate</a>
    </div>
    
<!-- Navigation -->
    <nav class="flex-1 px-4 py-4 space-y-1 overflow-y-auto">
      <a
        href={
          if assigns[:current_user] && assigns[:current_user].last_org_id,
            do: "/org/#{assigns[:current_user].last_org_id}",
            else: "/organizations"
        }
        class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-base-content/70 hover:bg-base-200 hover:text-base-content transition-colors"
      >
        <.icon name="hero-arrow-left" class="w-5 h-5" />
        <span>Back to organization</span>
      </a>

      <div class="pt-4 mt-4 border-t border-base-content/10">
        <div class="flex items-center gap-3 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-base-content/40">
          <.icon name="hero-user-circle" class="w-5 h-5" />
          <span>Account</span>
        </div>
        <div class="ml-8 space-y-0.5">
          <a
            href="/account"
            class={[
              "block px-3 py-1.5 rounded-lg text-sm transition-colors",
              assigns[:settings_page] == :security && "bg-base-200 text-base-content font-medium",
              assigns[:settings_page] != :security &&
                "text-base-content/70 hover:bg-base-200 hover:text-base-content"
            ]}
          >
            Security
          </a>
        </div>
      </div>
    </nav>
    
<!-- User section -->
    <div :if={assigns[:current_user]} class="border-t border-base-300 p-4">
      <div class="flex items-center gap-3">
        <.avatar
          name={@current_user.name || @current_user.email}
          seed={@current_user.id}
          size={:sm}
        />
        <div class="flex-1 min-w-0">
          <p class="text-sm font-medium text-base-content truncate">
            {@current_user.name || @current_user.email}
          </p>
          <p class="text-xs text-base-content/60 truncate">{@current_user.email}</p>
        </div>
        <.link
          href={~p"/users/log_out"}
          method="delete"
          class="text-base-content/40 hover:text-base-content/70"
        >
          <.icon name="hero-arrow-right-on-rectangle" class="w-5 h-5" />
        </.link>
      </div>
    </div>
  </aside>
  
<!-- Main content -->
  <div class="flex-1 flex flex-col overflow-hidden">
    <!-- Top bar -->
    <header class="h-16 bg-base-100 border-b border-base-300 flex items-center justify-end px-8">
      <div class="flex items-center gap-3">
        <.theme_toggle />
      </div>
    </header>
    
<!-- Page content -->
    <main class="flex-1 overflow-y-auto p-8">
      <.flash_group flash={@flash} />
      {@inner_content}
    </main>
  </div>
</div>
